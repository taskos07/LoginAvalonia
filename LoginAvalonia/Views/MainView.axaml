<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LoginAvalonia.ViewModels"
             x:Class="LoginAvalonia.Views.MainView"
             x:DataType="vm:MainViewModel">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="15" Width="300">
        
        <TextBlock Text="{Binding MessaggioBenvenuto}" 
                   FontSize="18" 
                   FontWeight="Bold" 
                   TextWrapping="Wrap" 
                   TextAlignment="Center"/>
        
        <TextBox Text="{Binding NomeUtente}" 
                 PlaceholderText="Inserisci il tuo nome..." />
        
        <Button Content="{Binding TestoPulsante}" 
                Command="{Binding EseguiLoginCommand}" 
                HorizontalAlignment="Stretch" />
        
        <ListBox x:Name="Nomi"/>
        
    </StackPanel>
</UserControl>