<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:LoginAvalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="LoginAvalonia.Views.MainView"
             x:DataType="vm:MainViewModel">
    
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="15" Width="300">
        
        <TextBlock Text="{Binding Greeting}" 
                   HorizontalAlignment="Center" 
                   FontSize="18" 
                   FontWeight="Bold" 
                   TextWrapping="Wrap" 
                   TextAlignment="Center"/>
        
        <TextBox Text="{Binding Username, Mode=TwoWay}" 
                 Watermark="Inserisci il tuo nome..." />
        
        <Button Content="{Binding ButtonText}" 
                Command="{Binding ExecuteLoginCommand}" 
                HorizontalAlignment="Stretch" 
                HorizontalContentAlignment="Center" />
        
    </StackPanel>
</UserControl>